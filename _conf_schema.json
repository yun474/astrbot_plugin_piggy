{
  "duplicate_rate_cap": {
    "description": "每日抽猪重复概率上限（%）",
    "type": "int",
    "default": 20,
    "hint": "0–100。实际重复率取已收集比例与此上限的较小值。0=有新猪就必出新猪；100=自然概率。集齐后仍会重复。"
  },
  "duplicate_pity": {
    "description": "连续重复保底次数",
    "type": "int",
    "default": 2,
    "hint": "0–30，0=关闭。连续抽到指定次数的重复猪后，下次必出未收集猪（如有）。漏签不清零，当天重复查看不累计；已有历史也计入。"
  },
  "draw_gather_chance": {
    "description": "猪群聚集概率（%）",
    "type": "int",
    "default": 50,
    "hint": "0–90。每抽到一只猪（含连抽出来的），按此概率再得到 1 只相同的猪。"
  },
  "draw_chain_chance": {
    "description": "小猪连抽概率（%）",
    "type": "int",
    "default": 50,
    "hint": "0–90。每抽到一只猪后，按此概率继续抽一只新猪，可一直连下去。期望数量 =（1+聚集概率）÷（1−连抽概率），默认 3 只。"
  },
  "display": {
    "description": "消息展示",
    "type": "object",
    "items": {
      "draw": {
        "description": "今日小猪使用图床",
        "type": "bool",
        "default": true,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "atlas": {
        "description": "小猪图鉴使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "pen": {
        "description": "我的猪圈使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "ranking": {
        "description": "小猪排行使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "shop": {
        "description": "小猪商店使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "duel": {
        "description": "斗猪海报与斗猪记录使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "wild": {
        "description": "野猪卡片与挑战海报使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "raid": {
        "description": "猪副本战报使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 继续/撤退按钮，并 @ 队长。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      }
    },
    "default": {
      "draw": true,
      "atlas": false,
      "pen": false,
      "ranking": false,
      "shop": false,
      "duel": false,
      "wild": false,
      "raid": false
    }
  },
  "backup_keep": {
    "description": "本地备份保留份数",
    "type": "int",
    "default": 7,
    "hint": "启动及每 24 小时备份一次；管理员也可执行小猪备份。备份不上传图床。"
  },
  "command_prefix": {
    "description": "快捷指令唤醒词",
    "type": "string",
    "default": "",
    "hint": "可选，默认留空：QQ 自动插入 @机器人，后面直接接命令。填写 /、! 或自定义唤醒词时会原样加在命令前；需要分隔空格时请一并填写。应与 AstrBot 配置一致。旧配置已保存的 / 可手动清空。"
  },
  "battle_level_cap": {
    "description": "小猪等级上限",
    "type": "int",
    "default": 20,
    "hint": "5–100。小猪等级等于拥有的同种猪数量，超过上限按上限计算；1–5 级依次解锁 5 个技能。"
  },
  "duel_daily_limit": {
    "description": "每日斗猪场数上限",
    "type": "int",
    "default": 5,
    "hint": "1–100。发起和应战都计入，按东八区自然日计算。"
  },
  "request_ttl_minutes": {
    "description": "斗猪/交换请求有效期（分钟）",
    "type": "int",
    "default": 10,
    "hint": "1–60。超时未处理的请求自动作废。"
  },
  "wild_level_max": {
    "description": "野生小猪最高等级",
    "type": "int",
    "default": 20,
    "hint": "1–100。每个群每天出现一只野猪，等级在 1 到此值之间随机。"
  },
  "battle_markdown": {
    "description": "斗猪/交换使用 Markdown 与按钮",
    "type": "bool",
    "default": false,
    "hint": "开启：@ 对方并附带接受/拒绝按钮（只有被邀请的本人发出才生效），需要机器人具备 Markdown 消息权限。关闭：发送纯文字。"
  },
  "show_image_host": {
    "description": "展开图床配置",
    "type": "bool",
    "default": false,
    "hint": "仅控制配置页显示；收起不会停用图床或清空已保存参数。"
  },
