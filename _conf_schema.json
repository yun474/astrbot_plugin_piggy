{
  "duplicate_rate_cap": {
    "description": "每日抽猪重复概率上限（%）",
    "type": "int",
    "default": 20,
    "hint": "0–100。实际重复率取已收集比例与此上限的较小值。0=有新猪就必出新猪；100=自然概率。集齐后仍会重复。"
  },
  "duplicate_pity": {
    "description": "连续重复保底次数",
    "type": "int",
    "default": 2,
    "hint": "0–30，0=关闭。连续抽到指定次数的重复猪后，下次必出未收集猪（如有）。漏签不清零，当天重复查看不累计；已有历史也计入。"
  },
  "display": {
    "description": "消息展示",
    "type": "object",
    "items": {
      "draw": {
        "description": "今日小猪使用图床",
        "type": "bool",
        "default": true,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "atlas": {
        "description": "小猪图鉴使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "pen": {
        "description": "我的猪圈使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      },
      "ranking": {
        "description": "小猪排行使用图床",
        "type": "bool",
        "default": false,
        "hint": "开启：图床图片 + Markdown + 按钮。关闭：内存渲染后直传 QQ，不带 MD 或按钮。"
      }
    },
    "default": {
      "draw": true,
      "atlas": false,
      "pen": false,
      "ranking": false
    }
  },
  "backup_keep": {
    "description": "本地备份保留份数",
    "type": "int",
    "default": 7,
    "hint": "启动及每 24 小时备份一次；管理员也可执行小猪备份。备份不上传图床。"
  },
  "command_prefix": {
    "description": "快捷指令唤醒词",
    "type": "string",
    "default": "",
    "hint": "可选，默认留空：QQ 自动插入 @机器人，后面直接接命令。填写 /、! 或自定义唤醒词时会原样加在命令前；需要分隔空格时请一并填写。应与 AstrBot 配置一致。旧配置已保存的 / 可手动清空。"
  },
  "show_image_host": {
    "description": "展开图床配置",
    "type": "bool",
    "default": false,
    "hint": "仅控制配置页显示；收起不会停用图床或清空已保存参数。"
  },
  "image_host": {
    "description": "图床配置",
    "type": "object",
    "condition": {
      "show_image_host": true
    },
    "hint": "四个消息功能共用所选图床；各家参数独立保存。",
    "items": {
      "provider": {
        "description": "图床类型",
        "type": "string",
        "default": "QQ 素材库",
        "options": [
          "QQ 素材库",
          "Cloudflare R2",
          "AWS S3",
          "阿里云 OSS",
          "腾讯云 COS",
          "七牛云 Kodo",
          "MinIO",
          "Backblaze B2",
          "DigitalOcean Spaces",
          "其他 S3 兼容存储",
          "兰空 Lsky Pro V2",
          "自定义 HTTP"
        ],
        "hint": "QQ 素材库无需填写参数：图片随消息上传、发送后立即删除。素材库每个机器人最多 100 张，与其他插件共用。其余类型仅显示所选图床的参数，各类型独立保存，切换回来无需重填。"
      },
      "qq": {
        "description": "QQ 素材库配置",
        "type": "object",
        "condition": {
          "provider": "QQ 素材库"
        },
        "hint": "无需填写 AppID 或密钥，直接沿用 AstrBot 中已配置的 QQ 官方机器人凭据。图片随消息上传、发送后立即删除；每个机器人最多 100 张，与其他插件共用；遇到限流、额度已满或无接口权限时自动改发卡片图片。",
        "items": {
          "cache_minutes": {
            "description": "猪图缓存时间（分钟）",
            "type": "int",
            "default": 0,
            "hint": "0–1440，0=即用即删，1440=1 天。缓存期间同一只小猪复用同一张素材，到期自动删除；图鉴、猪圈、排行卡片始终即用即删。每张缓存猪图占用一格共用额度，额度已满时会先释放本插件的缓存再重试。"
          },
          "usage_command": {
            "description": "启用小猪素材库指令",
            "type": "bool",
            "default": true,
            "hint": "管理员发送「小猪素材库」查看占用；「小猪素材库 删除缓存」删除本插件的全部素材；「小猪素材库 删除全部」清空整个素材库，其他插件的素材也会被删除。正在发送的图片会被跳过。关闭后插件不响应该指令。"
          }
        }
      },
      "r2": {
        "description": "Cloudflare R2 配置",
        "type": "object",
        "condition": {
          "provider": "Cloudflare R2"
        },
        "items": {
          "endpoint": {
            "description": "S3 上传接口",
            "type": "string",
            "default": "",
            "hint": "填写完整 HTTPS S3 API 端点，不含桶名；不是图片公网域名。例如 https://账户ID.r2.cloudflarestorage.com。"
          },
          "bucket": {
            "description": "S3 桶名",
            "type": "string",
            "default": "",
            "hint": "只填桶名称，不填 URL。"
          },
          "access_key": {
            "description": "S3 Access Key ID",
            "type": "string",
            "default": "",
            "hint": "使用只允许目标桶读写的 API 凭据；不要填写 Cloudflare 全局 API Key。"
          },
          "secret_key": {
            "description": "S3 Secret Access Key",
            "type": "string",
            "default": "",
            "hint": "密钥仅用于上传，不会放进 Markdown 或日志。"
          },
          "region": {
            "description": "S3 区域",
            "type": "string",
            "default": "auto",
            "hint": "填写服务商的实际区域。默认 auto。"
          },
          "public_base_url": {
            "description": "图片公网根地址",
            "type": "string",
            "default": "",
            "hint": "填写无需登录即可访问图片的桶域名或 CDN 地址，例如 https://img.example.com。"
          },
          "addressing_style": {
            "description": "S3 地址模式",
            "type": "string",
            "default": "auto",
            "hint": "auto 自动使用 path。通常无需修改。",
            "options": [
              "path",
              "virtual",
              "auto"
            ]
          }
        }
      },
