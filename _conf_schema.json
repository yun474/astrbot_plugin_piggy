          },
          "bucket": {
            "description": "S3 桶名",
            "type": "string",
            "default": "",
            "hint": "只填桶名称，不填 URL。"
          },
          "access_key": {
            "description": "S3 Access Key ID",
            "type": "string",
            "default": "",
            "hint": "使用只允许目标桶读写的 API 凭据；不要填写 Cloudflare 全局 API Key。"
          },
          "secret_key": {
            "description": "S3 Secret Access Key",
            "type": "string",
            "default": "",
            "hint": "密钥仅用于上传，不会放进 Markdown 或日志。"
          },
          "region": {
            "description": "S3 区域",
            "type": "string",
