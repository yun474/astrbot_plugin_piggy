          "addressing_style": {
            "description": "S3 地址模式",
            "type": "string",
            "default": "auto",
            "hint": "auto 自动使用 path。通常无需修改。",
            "options": [
              "path",
              "virtual",
              "auto"
            ]
          }
        }
      },
      "lsky": {
        "description": "兰空 Lsky Pro V2 配置",
        "type": "object",
        "condition": {
          "provider": "兰空 Lsky Pro V2"
        },
        "items": {
          "upload_url": {
            "description": "上传 API 地址",
            "type": "string",
            "default": "",
            "hint": "填写完整 HTTPS 地址，例如 https://你的图床/api/v1/upload。"
          },
          "authorization": {
            "description": "Authorization 鉴权值",
            "type": "string",
            "default": "",
            "hint": "例如 Bearer 你的Token；匿名上传可留空。"
          }
        }
      },
      "http": {
        "description": "自定义 HTTP 配置",
        "type": "object",
        "condition": {
          "provider": "自定义 HTTP"
        },
        "items": {
          "upload_url": {
            "description": "HTTP 图床上传 API",
            "type": "string",
            "default": "",
            "hint": "填写完整 HTTPS 上传接口地址。"
          },
          "upload_mode": {
            "description": "HTTP 上传编码",
            "type": "string",
            "default": "multipart",
            "hint": "multipart 上传文件；json_base64 将图片编码后放进 JSON 字段。",
            "options": [
              "multipart",
              "json_base64"
            ]
          },
          "upload_headers": {
            "description": "HTTP 请求头 JSON",
            "type": "text",
            "default": "{}",
            "hint": "例如 {\"Authorization\":\"Bearer token\"}。不要手填 multipart 的 Content-Type。"
          },
          "upload_fields": {
            "description": "HTTP 附加字段 JSON",
            "type": "text",
            "default": "{}",
            "hint": "例如 {\"strategy_id\":1} 或 {\"key\":\"API_KEY\",\"format\":\"json\"}。"
          },
          "file_field": {
            "description": "HTTP 图片字段名",
            "type": "string",
            "default": "file",
            "hint": "Lsky 通常为 file，Chevereto 通常为 source。"
          },
          "response_url_path": {
            "description": "HTTP 响应直链路径",
            "type": "string",
            "default": "data.links.url",
            "hint": "以点分隔对象字段/数组索引；例如 data.links.url、image.url、data.0.url。"
          },
          "success_path": {
            "description": "HTTP 成功状态路径",
            "type": "string",
            "default": "",
            "hint": "可选；例如 status 或 status_code。空值表示只验证 HTTP 状态和图片直链。"
          },
          "success_value": {
            "description": "HTTP 成功值 JSON",
            "type": "text",
            "default": "true",
            "hint": "填 true、200 或 \"success\"，必须与返回字段类型一致。"
          }
        }
      }
    }
