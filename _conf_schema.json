    "default": 168,
    "hint": "超过时间重新上传；QQ 明确报告图片转存失败时也会重新上传一次。应小于图床链接有效期。",
    "condition": {
      "show_network_settings": true
    }
  },
  "temp_cache_hours": {
    "description": "临时卡片 URL 缓存（小时）",
    "type": "int",
    "default": 12,
