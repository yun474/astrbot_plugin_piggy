          "AWS S3",
          "阿里云 OSS",
          "腾讯云 COS",
          "七牛云 Kodo",
          "MinIO",
          "Backblaze B2",
          "DigitalOcean Spaces",
          "其他 S3 兼容存储",
          "兰空 Lsky Pro V2",
          "自定义 HTTP"
