  "show_network_settings": {
    "description": "展开重试与缓存设置",
    "type": "bool",
    "default": false,
    "hint": "图床与 QQ 上传共用的高级设置，通常保持默认即可。"
  },
  "upload_retry_count": {
    "description": "图床 / QQ 本地上传失败重试次数",
    "type": "int",
    "default": 2,
    "hint": "不含首次请求；0=只尝试一次。仅重试网络异常、429 和服务端临时失败。",
    "condition": {
      "show_network_settings": true
    }
  },
  "image_retry_count": {
    "description": "QQ 图片转存/临时发送失败重试次数",
    "type": "int",
    "default": 3,
    "hint": "不含首次请求；0=只尝试一次。强制校验 QQ 图片转存，超时保留消息序号，明确拒绝后才更换序号。",
    "condition": {
      "show_network_settings": true
    }
  },
  "retry_base_delay": {
    "description": "重试基础间隔（秒）",
    "type": "float",
    "default": 1.0,
    "hint": "指数退避，单次等待上限 15 秒；本次处理最多等待约 240 秒。",
    "condition": {
      "show_network_settings": true
    }
  },
  "request_timeout": {
    "description": "单次网络请求超时（秒）",
    "type": "float",
    "default": 20.0,
    "hint": "图床上传及 QQ 请求的网络超时。",
